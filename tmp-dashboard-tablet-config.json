        {
          "square": false,
          "type": "grid",
          "cards": [
            {
              "type": "custom:mushroom-template-card",
              "primary": "{% if is_state('sensor.vaskemaskine', 'on') %}\n  Remaining {% set ct = states('sensor.washing_machine_washer_completion_time') | as_datetime %}{{ '00:00' if now() > ct else (ct - now()).total_seconds() | timestamp_custom('%H:%M', false) }}        \n{% elif is_state('sensor.washing_machine_washer_machine_state', 'pause') %}\n  Washing machine paused\n{% elif is_state('sensor.washing_machine_washer_machine_state', 'stop') %}\n  Washer off\n{% endif %}",
              "secondary": "{% if is_state('sensor.washing_machine_washer_machine_state', 'run') %}\n  Status: {{ states('sensor.washing_machine_washer_job_state') }}\n{% endif %}",
              "icon": "mdi:washing-machine",
              "entity": "sensor.washing_machine_washer_machine_state",
              "tap_action": {
                "action": "none"
              },
              "hold_action": {
                "action": "more-info"
              },
              "double_tap_action": {
                "action": "none"
              },
              "icon_color": "{% if is_state('sensor.vaskemaskine', 'on') %}\n  green         \n{% elif is_state('sensor.vaskemaskine', 'off') %}\n  dark-grey\n{% elif is_state('sensor.vaskemaskine', 'pause') %}\n  lightskyblue\n{% endif %}",
              "fill_container": false,
              "badge_icon": "",
              "picture": "",
              "layout": "horizontal",
              "card_mod": {
                "style": {
                  "mushroom-shape-icon$": ".shape {\n  --icon-symbol-size: 35px;\n  --icon-size: 55px;\n }\n",
                  "mushroom-state-info$": ".container {\n --card-primary-font-size: 18px;\n --card-secondary-font-size: 13px;\n}\n"
                }
