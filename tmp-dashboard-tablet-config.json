    {
      "title": "Solar",
      "path": "solar",
      "background": "center / cover no-repeat fixed url('/local/images/backgrounds/leaf-darker-background.png')",
      "type": "custom:vertical-layout",
      "cards": [
        {
          "type": "custom:stack-in-card",
          "mode": "vertical",
          "card_mod": {
            "style": "ha-card {\n  background: linear-gradient(145deg, rgba(26, 43, 29, 0.9) 0%, rgba(20, 34, 26, 0.72) 100%);\n  border: 1px solid rgba(165, 214, 167, 0.32);\n  border-radius: 24px;\n  box-shadow: 0 16px 34px rgba(0, 0, 0, 0.35);\n  backdrop-filter: blur(10px);\n  padding: 8px 6px 10px 6px;\n}\n"
          },
          "cards": [
            {
              "type": "grid",
              "columns": 2,
              "square": false,
              "cards": [
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "{{ (states('sensor.growatts_pv_power_total')|float(0) / 1000) | round(2) }} kW",
                  "secondary": "Solar now",
                  "icon": "mdi:solar-power-variant",
                  "icon_color": "amber",
                  "entity": "sensor.growatts_pv_power_total",
                  "multiline_secondary": false,
                  "fill_container": true,
                  "card_mod": {
                    "style": "ha-card {\n  min-height: 86px;\n  background: radial-gradient(circle at 15% 15%, rgba(246, 195, 68, 0.24), rgba(31, 40, 30, 0.88));\n  border: 1px solid rgba(246, 195, 68, 0.38);\n  border-radius: 18px;\n}\n:host {\n  --card-primary-font-size: 1.35rem;\n  --card-secondary-font-size: 0.88rem;\n}\n"
                  }
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "{{ states('sensor.growatts_battery_soc') }} %",
                  "secondary": "Battery",
                  "icon": "mdi:battery",
                  "icon_color": "{{ 'green' if states('sensor.growatts_battery_soc')|float(0) >= 60 else 'orange' if states('sensor.growatts_battery_soc')|float(0) >= 25 else 'red' }}",
                  "entity": "sensor.growatts_battery_soc",
                  "multiline_secondary": false,
                  "fill_container": true,
                  "card_mod": {
                    "style": "ha-card {\n  min-height: 86px;\n  background: radial-gradient(circle at 15% 15%, rgba(102, 187, 106, 0.2), rgba(31, 40, 30, 0.88));\n  border: 1px solid rgba(102, 187, 106, 0.36);\n  border-radius: 18px;\n}\n:host {\n  --card-primary-font-size: 1.35rem;\n  --card-secondary-font-size: 0.88rem;\n}\n"
                  }
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "{{ states('sensor.growatts_today_s_grid_import_2') }} kWh",
                  "secondary": "Grid import",
                  "icon": "mdi:transmission-tower-import",
                  "icon_color": "blue",
                  "entity": "sensor.growatts_today_s_grid_import_2",
                  "multiline_secondary": false,
                  "fill_container": true,
                  "card_mod": {
                    "style": "ha-card {\n  min-height: 86px;\n  background: radial-gradient(circle at 15% 15%, rgba(66, 165, 245, 0.2), rgba(31, 40, 30, 0.88));\n  border: 1px solid rgba(66, 165, 245, 0.38);\n  border-radius: 18px;\n}\n:host {\n  --card-primary-font-size: 1.35rem;\n  --card-secondary-font-size: 0.88rem;\n}\n"
                  }
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "{{ states('sensor.growatts_today_s_grid_export_2') }} kWh",
                  "secondary": "Grid export",
                  "icon": "mdi:transmission-tower-export",
                  "icon_color": "teal",
                  "entity": "sensor.growatts_today_s_grid_export_2",
                  "multiline_secondary": false,
                  "fill_container": true,
                  "card_mod": {
                    "style": "ha-card {\n  min-height: 86px;\n  background: radial-gradient(circle at 15% 15%, rgba(38, 198, 218, 0.2), rgba(31, 40, 30, 0.88));\n  border: 1px solid rgba(38, 198, 218, 0.36);\n  border-radius: 18px;\n}\n:host {\n  --card-primary-font-size: 1.35rem;\n  --card-secondary-font-size: 0.88rem;\n}\n"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "custom:apexcharts-card",
          "graph_span": "24h",
          "span": {
            "start": "day"
          },
          "header": {
            "show": true,
            "title": "Power Today",
            "show_states": true,
            "colorize_states": true
          },
          "series": [
            {
              "entity": "sensor.growatts_pv_power_total",
              "name": "Solar",
              "type": "area",
              "color": "#f6c344",
              "transform": "return Number(x) / 1000;",
              "group_by": {
                "duration": "10min",
                "func": "avg"
              }
            },
            {
              "entity": "sensor.growatts_house_load",
              "name": "Home load",
              "type": "line",
              "color": "#90caf9",
              "transform": "return Number(x) / 1000;",
              "group_by": {
                "duration": "10min",
                "func": "avg"
              }
            },
            {
              "entity": "sensor.growatts_grid_power",
              "name": "Grid power",
              "type": "line",
              "color": "#26c6da",
              "transform": "return Number(x) / 1000;",
              "group_by": {
                "duration": "10min",
                "func": "avg"
              }
            }
          ],
          "yaxis": [
            {
              "decimals": 2,
              "min": 0,
              "max": "|+0.2|"
            }
          ],
          "apex_config": {
            "chart": {
              "height": 260
            },
            "stroke": {
              "width": [
                2,
                3,
                3
              ],
              "curve": "smooth"
            },
            "grid": {
              "borderColor": "rgba(160, 186, 166, 0.2)",
              "strokeDashArray": 4
            },
            "tooltip": {
              "theme": "dark"
            },
            "legend": {
              "position": "top"
            }
          },
          "card_mod": {
            "style": "ha-card {\n  margin-top: 10px;\n  background: linear-gradient(160deg, rgba(17, 32, 24, 0.92) 0%, rgba(16, 28, 23, 0.78) 100%);\n  border: 1px solid rgba(144, 202, 249, 0.25);\n  border-radius: 22px;\n  box-shadow: 0 14px 28px rgba(0, 0, 0, 0.32);\n}\n"
          }
