              "secondary": "{% if is_state('sensor.tumble_dryer_dryer_machine_state', 'run') %}\n  Status: {{ states('sensor.tumble_dryer_dryer_job_state') }}\n{% endif %}",
              "icon": "mdi:tumble-dryer",
              "entity": "sensor.tumble_dryer_dryer_machine_state",
              "tap_action": {
                "action": "none"
              },
              "hold_action": {
                "action": "more-info"
              },
              "double_tap_action": {
                "action": "none"
              },
              "icon_color": "{% if is_state('sensor.tumble_dryer_dryer_machine_state', 'run') %}\n  green         \n{% elif is_state('sensor.tumble_dryer_dryer_machine_state', 'stop') %}\n  dark-grey\n{% elif is_state('sensor.tumble_dryer_dryer_machine_state', 'pause') %}\n  lightskyblue\n{% endif %}",
              "fill_container": false,
              "badge_icon": "",
              "picture": "",
              "layout": "horizontal",
              "card_mod": {
                "style": {
                  "mushroom-shape-icon$": ".shape {\n  --icon-symbol-size: 35px;\n  --icon-size: 55px;\n}\n",
                  "mushroom-state-info$": ".container {\n --card-primary-font-size: 18px;\n --card-secondary-font-size: 13px;\n}\n"
                }
              }
            }
          ],
